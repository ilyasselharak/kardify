# ─── Core ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://kardify:kardify@localhost:5432/kardify
# Optional connection-pool size per API instance (default 10)
DATABASE_POOL_MAX=
# Public origin of the web app (used in emails, card URLs, QR codes, wallet passes)
FRONTEND_URL=http://localhost:3000
# Public origin of this API. Must be HTTPS in production for Apple Wallet pass updates.
API_PUBLIC_URL=http://localhost:4000
# Comma-separated origins allowed to call the API with cookies
CORS_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=true
# Reverse proxies in front of the API (e.g. 2 for Vercel rewrite -> Render)
TRUST_PROXY_HOPS=1

# ─── Auth ──────────────────────────────────────────────────────────────
# REQUIRED in production. Generate with: openssl rand -base64 48
JWT_SECRET=
SESSION_TTL_HOURS=24
REMEMBER_ME_TTL_DAYS=30
# Optional: share the session cookie across subdomains, e.g. .kardify.com
COOKIE_DOMAIN=

# ─── Redis (cache, analytics de-duplication, rate-limit windows) ────────
# If empty, an in-memory fallback is used (single instance only).
REDIS_URL=redis://localhost:6379

# ─── Email (Resend) ─────────────────────────────────────────────────────
# If empty, emails are printed to the API log instead of being sent.
RESEND_API_KEY=
EMAIL_FROM=Kardify <no-reply@kardify.com>

# ─── Image uploads (Cloudinary) ─────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=kardify

# ─── Apple Wallet (see README → Apple Wallet setup) ─────────────────────
# PEM values may be pasted with literal \n, or base64-encoded.
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_ORGANIZATION_NAME=Kardify
APPLE_WWDR_CERT=
APPLE_SIGNER_CERT=
APPLE_SIGNER_KEY=
APPLE_SIGNER_KEY_PASSPHRASE=
# api.push.apple.com (production) or api.sandbox.push.apple.com
APPLE_APNS_HOST=https://api.push.apple.com

# ─── Google Wallet (see README → Google Wallet setup) ───────────────────
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
# Private key from the service-account JSON (keep the \n escapes)
GOOGLE_WALLET_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_WALLET_CLASS_SUFFIX=kardify_business_card_v1

# ─── NestJS Observe (optional telemetry) ────────────────────────────────
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
